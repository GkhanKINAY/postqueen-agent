{
  "name": "dsh-postqueen",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin that connects the agent to PostQueen over MCP: list connected channels, fetch platform posting rules, and schedule, draft, or publish social media posts across 30+ platforms.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
